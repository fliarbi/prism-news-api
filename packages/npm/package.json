{
  "name": "prism-news-api",
  "version": "0.1.0",
  "description": "Zero-dependency client, CLI and open topic datasets (2019-2026) for the Prism News API by Fliar: 450M+ news articles with sentiment, priority, themes and geography.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "bin": {
    "prism-news": "bin/prism-news.js",
    "prism-news-api": "bin/prism-news.js"
  },
  "files": ["index.js", "index.d.ts", "bin/", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": { "test": "node --test" },
  "keywords": ["news", "news-api", "news-data", "datasets", "sentiment", "media-monitoring", "open-data", "fliar", "prism"],
  "author": "Fliar Research <b2b@fliarbi.com>",
  "license": "MIT",
  "homepage": "https://github.com/fliarbi/prism-news-api/tree/main/packages/npm#readme",
  "repository": { "type": "git", "url": "git+https://github.com/fliarbi/prism-news-api.git", "directory": "packages/npm" },
  "bugs": { "url": "https://github.com/fliarbi/prism-news-api/issues" }
}
