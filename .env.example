# Deployment settings for the Prism News API. Copy to .env (never commit .env).
# Real environment variables override this file.
PRISM_CH_HOST=http://localhost:8123
PRISM_CH_USER=default
PRISM_CH_PASSWORD=change-me
PRISM_NEWS_TABLE=news.articles
PRISM_MONGO_URI=mongodb://localhost:27017/
PRISM_AUTH_DB=prism_auth
PRISM_REDIS_HOST=localhost
PRISM_REDIS_PORT=6379
PRISM_REDIS_DB=6
# directory holding the article-store ring module main.py
PRISM_NEWS_COMMON=/srv/news/common
PRISM_NEWS_COMMON_FALLBACK=
# scripts/export_gcp_code_map.py only
PRISM_CLASSES_REDIS_HOST=localhost
PRISM_CLASSES_REDIS_PORT=6379
# One key for Radar API and Prism News: the Radar API gateway's private key check.
# Leave empty to accept only pna_ keys.
PRISM_RADAR_KEYS_URL=
PRISM_RADAR_KEYS_HOST=
PRISM_RADAR_KEYS_SECRET=
